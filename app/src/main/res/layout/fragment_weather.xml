<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <EditText
            android:id="@+id/cityInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_spinner"
            android:hint="@string/weather_city_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="?attr/maText"
            android:textColorHint="?attr/maTextMuted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/searchButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/weather_search" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/myLocationButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/weather_my_location" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accessPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner_dropdown"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weather_location_needed"
                android:textColor="?attr/maText"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/accessButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="100dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="?attr/maText"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/cityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/maText"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/countryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/maTextSecondary"
                android:textSize="16sp" />

            <com.yurii.pavlenko.myassistant.weather.ui.PortholeView
                android:id="@+id/porthole"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/maText"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/maText"
                android:textSize="18sp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_spinner_dropdown"
                android:padding="16dp"
                android:stretchColumns="1">

                <TableRow
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="@string/weather_feels_like"
                        android:textColor="?attr/maTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailFeelsLike"
                        android:gravity="end"
                        android:textColor="?attr/maText"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="@string/weather_humidity"
                        android:textColor="?attr/maTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailHumidity"
                        android:gravity="end"
                        android:textColor="?attr/maText"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="@string/weather_wind"
                        android:textColor="?attr/maTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailWind"
                        android:gravity="end"
                        android:textColor="?attr/maText"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

                <TableRow
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:text="@string/weather_today_range"
                        android:textColor="?attr/maTextSecondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/detailRange"
                        android:gravity="end"
                        android:textColor="?attr/maText"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </TableRow>

            </TableLayout>

            <com.yurii.pavlenko.myassistant.weather.ui.PortholeView
                android:id="@+id/moonWindow"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/moonCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/maText"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/unitsButton"
                    style="@style/Widget.MyAssistant.ScanButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="100dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/weather_units" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="@string/weather_attribution"
            android:textColor="?attr/maTextMuted"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
