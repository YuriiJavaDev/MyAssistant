<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with the Classic design. The colours come from colors.xml, which has a dark variant in values-night;
         the other designs are the Design.* overlays of design_styles.xml. -->
    <style name="Base.Theme.MyAssistant" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialSwitchStyle">@style/MyAssistantMaterialSwitch</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>

        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>

        <item name="maBackground">@color/background</item>
        <item name="maText">@color/text_color</item>
        <item name="maTextSecondary">@color/text_secondary</item>
        <item name="maTextMuted">@color/text_muted</item>
        <item name="maOutline">@color/outline</item>
        <item name="maTabSelected">@color/tab_selected</item>
        <item name="maTabText">@color/colorPrimary</item>
        <item name="maSwitchTrack">@color/switch_track</item>
        <item name="maAccent">@color/colorPrimary</item>
        <item name="maButtonLabel">@color/text_color_btn</item>
        <item name="maButtonStart">@color/button_start</item>
        <item name="maButtonEnd">@color/button_end</item>
        <item name="maButtonPressedEnd">@color/button_pressed_end</item>
        <item name="maButtonStrokeColor">@android:color/transparent</item>
        <item name="maOverdue">@color/status_overdue</item>
        <item name="maImportant">@color/status_important</item>
        <item name="maOk">@color/status_ok</item>
        <item name="maCorner">20dp</item>
        <item name="maCornerPanel">16dp</item>
        <item name="maCornerTab">18dp</item>
        <item name="maStroke">1.5dp</item>
        <item name="maButtonStroke">0dp</item>
        <item name="maBackdrop">@drawable/backdrop_classic</item>
    </style>

    <style name="Theme.MyAssistant" parent="Base.Theme.MyAssistant" />

    <style name="CustomPopupMenuItemTextAppearance" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="CustomPopupMenu" parent="ThemeOverlay.Material3">
        <item name="android:popupBackground">@drawable/bg_spinner_dropdown</item>
        <item name="popupMenuBackground">@drawable/bg_spinner_dropdown</item>
        <item name="android:itemTextAppearance">@style/CustomPopupMenuItemTextAppearance</item>
        <item name="android:listPreferredItemHeightSmall">38dp</item>
    </style>

    <style name="MyAssistantMaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/colorPrimary</item>
        <item name="trackTint">@color/switch_track</item>
    </style>
</resources>
