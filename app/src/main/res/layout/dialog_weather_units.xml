<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_spinner_dropdown"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_units_temperature"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/temperatureGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/celsius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/maAccent"
                android:text="@string/weather_unit_celsius"
                android:textColor="?attr/maText"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/fahrenheit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/maAccent"
                android:text="@string/weather_unit_fahrenheit"
                android:textColor="?attr/maText"
                android:textSize="14sp" />

    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/weather_units_wind"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/windGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/metresPerSecond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/maAccent"
                android:text="@string/weather_unit_ms"
                android:textColor="?attr/maText"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/kilometresPerHour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="?attr/maAccent"
                android:text="@string/weather_unit_kmh"
                android:textColor="?attr/maText"
                android:textSize="14sp" />

    </RadioGroup>
</LinearLayout>
