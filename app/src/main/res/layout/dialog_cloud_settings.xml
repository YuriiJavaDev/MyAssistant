<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_spinner_dropdown">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cloud Settings &amp; Auto-backup"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WebDAV Server URL:"
        android:textColor="@color/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/etWebDavUrl"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="https://dav.koofr.net/dav/Koofr/Backups/"
        android:textSize="12sp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="10dp"
        android:inputType="textUri"
        android:textColor="@color/text_color"
        android:backgroundTint="@color/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Username:"
        android:textColor="@color/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/etUsername"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Your username / email"
        android:textSize="12sp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="10dp"
        android:inputType="textEmailAddress"
        android:textColor="@color/text_color"
        android:backgroundTint="@color/colorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password / App Token:"
        android:textColor="@color/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:hint="Password or app-specific token"
        android:textSize="12sp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="12dp"
        android:inputType="textPassword"
        android:textColor="@color/text_color"
        android:backgroundTint="@color/colorPrimary" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/cbAutoBackup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Daily Auto-backup"
        android:textSize="14sp"
        android:textColor="@color/text_color"
        android:layout_marginBottom="10dp"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:pivotX="100%"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ When automatic backup is enabled, the database file in your cloud storage will be overwritten once a day by default."
        android:textSize="11sp"
        android:textColor="@color/text_color"
        android:alpha="0.7"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTestConnection"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_selector"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="Test"
            android:textAllCaps="false"
            android:textColor="@color/text_color_btn"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveConfig"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_selector"
            android:paddingHorizontal="16dp"
            android:stateListAnimator="@null"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/text_color_btn"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>