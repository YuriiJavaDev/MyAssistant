<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_spinner_dropdown"
    android:padding="16dp"
    android:stretchColumns="1">
    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_time"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/flightTime"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_distance"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/distance"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_max_speed"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/maxSpeed"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_avg_speed"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/averageSpeed"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_max_altitude"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/maxAltitude"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_climb_rate"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/climbRate"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>

    <TableRow
        android:paddingTop="4dp"
        android:paddingBottom="4dp">
        <TextView
            android:text="@string/flights_max_g"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/maxG"
            android:gravity="end"
            android:textColor="@color/text_color"
            android:textSize="14sp"
            android:textStyle="bold" />
    </TableRow>
</TableLayout>
