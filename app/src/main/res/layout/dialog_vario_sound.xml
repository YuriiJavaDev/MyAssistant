<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_spinner_dropdown"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:id="@+id/climbStartLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/climbStartSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:progressTint="@color/colorPrimary"
        android:thumbTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/sinkStartLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/sinkStartSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:progressTint="@color/colorPrimary"
        android:thumbTint="@color/colorPrimary" />

    <TextView
        android:id="@+id/sinkAlarmLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/sinkAlarmSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="@color/colorPrimary"
        android:thumbTint="@color/colorPrimary" />
</LinearLayout>
