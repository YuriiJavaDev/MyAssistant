<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/maBackdrop"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Toolbar with title on the left and 3-dot menu on the right -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:popupTheme="@style/CustomPopupMenu"
        app:title="MyAssistant"
        app:titleTextColor="?attr/maText" />

    <!-- First row of tabs (4 items) - compact centered pills -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:tabBackground="@drawable/tab_background"
        app:tabGravity="center"
        app:tabIndicatorColor="?attr/maAccent"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="?attr/maTabText"
        app:tabTextColor="?attr/maText"
        app:tabTextAppearance="@style/MyTabTextAppearance" />

    <!-- Second row of tabs (3 items) - compact centered pills -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutSecond"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:tabBackground="@drawable/tab_background"
        app:tabGravity="center"
        app:tabIndicatorColor="?attr/maAccent"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="?attr/maTabText"
        app:tabTextColor="?attr/maText"
        app:tabTextAppearance="@style/MyTabTextAppearance" />

    <!-- Screen content container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>