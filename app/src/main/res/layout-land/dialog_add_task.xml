<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/bg_spinner_dropdown">

        <TextView
            android:id="@+id/dialogTitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Task"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_color"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/dialogTaskEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:inputType="text|textCapSentences"
            android:textColor="@color/text_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Importance level:"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_spinner">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:src="@android:drawable/arrow_down_float"
                        app:tint="#3E2773" />

                    <Spinner
                        android:id="@+id/dialogImportanceSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/bg_spinner_dropdown"
                        android:paddingStart="8dp"
                        android:paddingEnd="26dp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deadline:"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/dialogDeadlineTextView"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="Select deadline"
                    android:textSize="12sp"
                    android:background="@drawable/bg_spinner"
                    android:textColor="@color/text_color" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/dialogRemindCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remind 1 day before"
                android:textSize="11sp"
                android:textColor="@color/text_color"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/dialogCustomReminderTextView"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="Reminder date &amp; time"
                android:textSize="11sp"
                android:background="@drawable/bg_spinner"
                android:textColor="@color/text_color" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/dialogShowTimestampsCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show creation dates"
                android:textSize="11sp"
                android:textColor="@color/text_color" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_selector"
                app:backgroundTint="@null"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="@color/text_color_btn"
                android:textSize="11sp"
                style="?attr/materialButtonOutlinedStyle" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_selector"
                app:backgroundTint="@null"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_color_btn"
                android:textSize="11sp"
                style="?attr/materialButtonOutlinedStyle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:background="@drawable/button_selector"
                app:backgroundTint="@null"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/text_color_btn"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>