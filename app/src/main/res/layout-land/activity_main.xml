<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/maBackdrop"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Toolbar containing title, inline tab layout, and overflow menu -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:popupTheme="@style/CustomPopupMenu"
        app:title="MyAssistant"
        app:titleTextColor="?attr/maText">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            app:tabBackground="@drawable/tab_background"
            app:tabGravity="center"
            app:tabIndicatorColor="?attr/maAccent"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="?attr/maTabText"
            app:tabTextColor="?attr/maText"
            app:tabTextAppearance="@style/MyTabTextAppearance" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>