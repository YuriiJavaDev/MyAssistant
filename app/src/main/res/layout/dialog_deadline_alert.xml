<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:padding="24dp"
    tools:ignore="HardcodedText, ImageContentDescription">

    <!-- Твоя оригінальна картка, відцентрована по екрану -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp"
        android:background="@drawable/bg_spinner_dropdown">

        <!-- Warning triangle icon -->
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_megaphone"
            app:tint="#D32F2F" />

        <!-- Dialog title header (Bold and Red) -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadline Alert!"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Task title or consolidated count content (set dynamically in Java) -->
        <TextView
            android:id="@+id/tvTaskTitleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#3E2773"
            android:gravity="center"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="4dp"
            tools:text="You have pending tasks." />

        <!-- Action button ("View Tasks" / "Got it") with custom background and text color -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissAlert"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:text="View Tasks"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:background="@drawable/button_selector"
            app:backgroundTint="@null"
            android:textColor="@color/text_color_btn"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>

</FrameLayout>