<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Тут буде поле введення завдання -->
    <EditText android:hint="Что нужно сделать?" android:id="@+id/taskInput" android:inputType="textCapSentences" android:layout_height="wrap_content" android:layout_width="0dp" app:layout_constraintEnd_toStartOf="@+id/addButton" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/button_selector"
        android:text="Add"
        android:textAllCaps="false"
        android:textColor="@color/text_color_btn"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:minWidth="100dp"
        android:stateListAnimator="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Місце під майбутній список завдань -->
    <TextView android:layout_height="wrap_content" android:layout_marginTop="64dp" android:layout_width="wrap_content" android:text="Тут буде список завдань (Tasks)" android:textSize="18sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/taskInput"/>

</androidx.constraintlayout.widget.ConstraintLayout>