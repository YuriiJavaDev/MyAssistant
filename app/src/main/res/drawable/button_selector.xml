<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <inset
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="55"
                    android:startColor="?attr/maButtonEnd"
                    android:endColor="?attr/maButtonPressedEnd"/>
                <stroke
                    android:width="?attr/maButtonStroke"
                    android:color="?attr/maButtonStrokeColor" />
                <corners android:radius="?attr/maCorner" />
            </shape>
        </inset>
    </item>

    <item>
        <inset
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="125"
                    android:startColor="?attr/maButtonStart"
                    android:endColor="?attr/maButtonEnd" />
                <stroke
                    android:width="?attr/maButtonStroke"
                    android:color="?attr/maButtonStrokeColor" />
                <corners android:radius="?attr/maCorner" />
            </shape>
        </inset>
    </item>

</selector>
