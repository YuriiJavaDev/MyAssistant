<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/accessPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_spinner_dropdown"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/accessMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/accessButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="100dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner_dropdown"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/steps_today"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/todaySteps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todayDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/todaySplit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner_dropdown"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/steps_period"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/periodRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/last7Button"
                    style="@style/Widget.MyAssistant.ScanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/steps_last_7" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/last30Button"
                    style="@style/Widget.MyAssistant.ScanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="@string/steps_last_30" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/monthButton"
                    style="@style/Widget.MyAssistant.ScanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/steps_this_month" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/pickDatesButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/steps_pick_dates" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stretchColumns="1">

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_total"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statTotal"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_distance"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statDistance"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_average"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statAverage"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_best_day"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statBest"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_walking"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statWalking"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_running"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statRunning"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:paddingTop="4dp" android:paddingBottom="4dp">

                <TextView
                    android:text="@string/steps_active_days"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/statActive"
                    android:gravity="end"
                    android:textColor="@color/text_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            </TableLayout>

            <TextView
                android:id="@+id/periodEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/steps_no_data"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dayRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/settingsButton"
                style="@style/Widget.MyAssistant.ScanButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/steps_settings" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
