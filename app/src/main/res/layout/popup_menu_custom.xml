<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_spinner_dropdown"
    android:elevation="8dp"
    android:paddingVertical="4dp">

    <!-- Local storage options -->
    <TextView
        android:id="@+id/action_export_db"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text="@string/backup_menu_export"
        style="@style/CustomPopupMenuItemTextAppearance"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/action_import_db"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text="@string/backup_menu_import"
        style="@style/CustomPopupMenuItemTextAppearance"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"/>

    <!-- Custom Divider View with tight margins -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="?attr/maOutline"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp" />

    <!-- Cloud storage options -->
    <TextView
        android:id="@+id/action_cloud_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text="@string/backup_menu_cloud_settings"
        style="@style/CustomPopupMenuItemTextAppearance"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/action_cloud_export"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text="@string/backup_menu_cloud_save"
        style="@style/CustomPopupMenuItemTextAppearance"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/action_cloud_import"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="28dp"
        android:gravity="center_vertical"
        android:text="@string/backup_menu_cloud_restore"
        style="@style/CustomPopupMenuItemTextAppearance"
        android:paddingHorizontal="16dp"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>