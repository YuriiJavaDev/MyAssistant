<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_spinner_dropdown">

    <!-- Dialog Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_alarm_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/maText"
        android:paddingBottom="16dp"/>

    <!-- Voice Alert Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchVoiceAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_alarm_voice_alert"
        android:textColor="?attr/maText"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"
        app:thumbTint="?attr/maText" />

    <!-- Full-Screen Pop-up Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchFullScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_alarm_full_screen"
        android:textColor="?attr/maText"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        app:thumbTint="?attr/maText" />

    <!-- Exact Alarm Permission Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExactAlarmPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_selector"
        app:backgroundTint="@null"
        android:text="@string/app_alarm_grant_exact"
        android:textAllCaps="false"
        android:textColor="?attr/maButtonLabel"
        android:textSize="14sp"
        style="?attr/materialButtonOutlinedStyle" />

</LinearLayout>