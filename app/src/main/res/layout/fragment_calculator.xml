<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <include
        android:id="@+id/display"
        layout="@layout/calculator_display" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="5">
                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/calc_memory_key_height"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="MEMORY_ADD" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/calc_memory_key_height"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="MEMORY_RECALL" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/calc_memory_key_height"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="MEMORY_CLEAR" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/calc_memory_key_height"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="OPEN" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/calc_memory_key_height"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="CLOSE" />
            </GridLayout>

            <LinearLayout
                android:id="@+id/scientificPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <include
                    layout="@layout/calculator_sci_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:minHeight="@dimen/calc_keypad_min_height"
                android:columnCount="4">
                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="CLEAR" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="BACK" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="PERCENT" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="DIVIDE" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="SEVEN" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="EIGHT" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="NINE" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="MULTIPLY" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="FOUR" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="FIVE" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="SIX" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="SUBTRACT" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="ONE" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="TWO" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="THREE" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="ADD" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/scientificToggle"
                    style="@style/Widget.MyAssistant.CalcKey.Function"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="ZERO" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="DOT" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Widget.MyAssistant.CalcKey"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_gravity="fill"
                    android:layout_margin="1dp"
                    android:tag="EQUALS" />
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
