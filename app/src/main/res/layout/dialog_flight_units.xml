<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_spinner_dropdown">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/flights_units_speed"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/speedGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/kilometresPerHour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_kmh"
            android:textColor="?attr/maText"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/knots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_knots"
            android:textColor="?attr/maText"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/metresPerSecond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_ms"
            android:textColor="?attr/maText"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/flights_units_altitude"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/altitudeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/metres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_metres"
            android:textColor="?attr/maText"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/feet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_feet"
            android:textColor="?attr/maText"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/flights_units_climb"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/climbGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <RadioButton
            android:id="@+id/metresPerSecondClimb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_ms"
            android:textColor="?attr/maText"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/feetPerMinute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="?attr/maAccent"
            android:text="@string/flights_unit_fpm"
            android:textColor="?attr/maText"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/flights_units_report_limit"
        android:textColor="?attr/maAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/reportLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints="none"
        android:hint="@string/flights_units_report_limit_hint"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4"
        android:textColor="?attr/maText"
        android:textColorHint="?attr/maTextMuted"
        android:textSize="14sp" />
</LinearLayout>
</ScrollView>
