<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_spinner_dropdown">

    <!-- Dialog Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reminders and Alarms"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#3E2773"
        android:paddingBottom="16dp"/>

    <!-- Voice Alert Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchVoiceAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voice Alert (TTS)"
        android:textColor="#3E2773"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"
        app:thumbTint="#3E2773" />

    <!-- Full-Screen Pop-up Switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchFullScreen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Full-Screen Pop-up"
        android:textColor="#3E2773"
        android:textSize="14sp"
        android:layout_marginBottom="16dp"
        app:thumbTint="#3E2773" />

    <!-- Exact Alarm Permission Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExactAlarmPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/button_selector"
        app:backgroundTint="@null"
        android:text="Grant Exact Alarm Permission"
        android:textAllCaps="false"
        android:textColor="@color/text_color_btn"
        android:textSize="14sp"
        style="?attr/materialButtonOutlinedStyle" />

</LinearLayout>